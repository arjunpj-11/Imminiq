PORT=5000
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/imminiq
REDIS_URL=rediss://USER:PASSWORD@HOST:PORT
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_EXPIRES_IN=15m
CLIENT_URL=https://imminiq-web.vercel.app
SERVER_URL=https://imminiq-api.onrender.com
# Optional after moving both services to sibling custom domains:
# AUTH_COOKIE_DOMAIN=.imminiq.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
YOUTUBE_DATA_API_KEY=
# Metered Dashboard -> Developers. Keep the secret key on the API only.
METERED_TURN_API_BASE_URL=https://YOUR_APP.metered.live
# Preferred on plans that support expiring credentials.
METERED_TURN_SECRET_KEY=
# Free-tier/static alternative: create a TURN credential in the Metered dashboard
# and copy its credential-scoped API key here.
METERED_TURN_API_KEY=
METERED_TURN_CREDENTIAL_TTL_SECONDS=14400
METERED_TURN_REQUEST_TIMEOUT_MS=8000
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
NODE_ENV=development
BCRYPT_ROUNDS=12
OTP_EXPIRES_MINUTES=10

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MESSAGE_CENTRAL_CUSTOMER_ID=
MESSAGE_CENTRAL_EMAIL=
MESSAGE_CENTRAL_PASSWORD=
MESSAGE_CENTRAL_COUNTRY_CODE=91
MESSAGE_CENTRAL_BASE_URL=https://cpaas.messagecentral.com
TOTP_ENCRYPTION_KEY=replace-with-exactly-64-hex-characters
PISTON_API_URL=https://emkc.org/api/v2/piston
PISTON_API_KEY=
SHUTDOWN_TIMEOUT_MS=30000
REFRESH_TOKEN_TTL_MS=604800000
TWO_FACTOR_CHALLENGE_TTL_MINUTES=5
PASSWORD_RESET_TOKEN_TTL_SECONDS=600
PENDING_REGISTRATION_TTL_SECONDS=600
OAUTH_STATE_TTL_SECONDS=600
SECURITY_EMAIL_CHANGE_TOKEN_TTL_MINUTES=10

# Brute-force protection
AUTH_LOGIN_ATTEMPT_WINDOW_SECONDS=900
AUTH_LOGIN_MAX_ATTEMPTS=8
AUTH_LOGIN_BLOCK_SECONDS=900
OTP_ATTEMPT_WINDOW_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_BLOCK_SECONDS=600
TWO_FACTOR_ATTEMPT_WINDOW_SECONDS=600
TWO_FACTOR_MAX_ATTEMPTS=5
TWO_FACTOR_BLOCK_SECONDS=600

# HTTP rate limiting
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=6000
RATE_LIMIT_AUTHENTICATED_API_WINDOW_MS=900000
RATE_LIMIT_AUTHENTICATED_API_MAX=3000
RATE_LIMIT_AUTH_SESSION_WINDOW_MS=600000
RATE_LIMIT_AUTH_SESSION_MAX=60
RATE_LIMIT_PUBLIC_LOOKUP_WINDOW_MS=600000
RATE_LIMIT_PUBLIC_LOOKUP_MAX=80
RATE_LIMIT_OAUTH_WINDOW_MS=600000
RATE_LIMIT_OAUTH_MAX=40
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=25
RATE_LIMIT_SENSITIVE_WINDOW_MS=600000
RATE_LIMIT_SENSITIVE_DEFAULT_MAX=20
RATE_LIMIT_OTP_SEND_MAX=8
RATE_LIMIT_FORGOT_PASSWORD_MAX=8
RATE_LIMIT_RESET_PASSWORD_MAX=12
RATE_LIMIT_MODERATION_APPEAL_WINDOW_MS=900000
RATE_LIMIT_MODERATION_APPEAL_MAX=20

# Uploads, queues, and AI runtime
UPLOAD_IMAGE_MAX_BYTES=5242880
UPLOAD_AVATAR_MAX_BYTES=5242880
UPLOAD_BANNER_MAX_BYTES=8388608
MOCK_TEST_AI_GENERATION_ENABLED=true
QUEUE_JOB_ATTEMPTS=3
QUEUE_JOB_BACKOFF_MS=5000
QUEUE_REMOVE_ON_COMPLETE=100
QUEUE_REMOVE_ON_FAIL=200
AI_WORKER_CONCURRENCY=1
AI_WORKER_REQUESTS_PER_MINUTE=2
GROQ_DEFAULT_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_MAX_TOKENS=4096
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
GEMINI_NEXT_MODEL=gemini-3.1-flash-lite
GEMINI_HISTORY_MODEL=gemini-1.5-pro
CEREBRAS_MODEL=gpt-oss-120b
YOUTUBE_REQUEST_TIMEOUT_MS=8000
YOUTUBE_MAX_RESULTS=5
LEADERBOARD_SNAPSHOT_BATCH_SIZE=1000
PLAN_LIMIT_USAGE_TTL_SECONDS=34560000
DASHBOARD_ONLINE_WINDOW_MS=300000
