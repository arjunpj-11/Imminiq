# Copy this file to .env.development for local work. Configure the same keys in
# Doppler for production; do not commit environment-specific files.
# GitHub Actions supplies the public AWS URLs during production builds.
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
VITE_WEBRTC_STUN_URL=stun:stun.l.google.com:19302
# Long-running synchronous AI operations such as guild battle generation.
VITE_LONG_REQUEST_TIMEOUT_MS=120000

# Build-time pagination and list sizing
VITE_PAGINATION_DEFAULT_LIMIT=20
VITE_PAGINATION_PROFILE_LIMIT=10
VITE_PAGINATION_COMPACT_LIMIT=6
VITE_PAGINATION_GRID_LIMIT=12
VITE_PAGINATION_ADMIN_LIMIT=25
VITE_PAGINATION_BATCH_LIMIT=50
VITE_PAGINATION_MESSAGE_LIMIT=60
VITE_PAGINATION_LOOKUP_LIMIT=100
VITE_DASHBOARD_RECENT_BATTLE_LIMIT=3
VITE_DASHBOARD_FRIEND_LIMIT=4
VITE_PROFILE_HIGHLIGHT_LIMIT=3
