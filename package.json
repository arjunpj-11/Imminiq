{
  "name": "imminiq",
  "private": true,
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "piston:up": "docker compose up -d piston",
    "piston:down": "docker compose stop piston",
    "services:up": "docker compose up -d --wait piston redis",
    "services:down": "docker compose down",
    "dev": "npm run services:up && REDIS_URL=redis://127.0.0.1:6379 turbo run dev --env-mode=loose",
    "dev:web": "turbo run dev --filter=@imminiq/web",
    "dev:api": "npm run services:up && REDIS_URL=redis://127.0.0.1:6379 turbo run dev --filter=@imminiq/api --env-mode=loose",
    "build": "turbo run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check": "npm run format:check && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "postcss": "^8.5.23",
    "prettier": "3.9.6",
    "tsc-alias": "^1.9.2",
    "turbo": "latest",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "passport-strategy": "^1.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
